  "procedure": {
    "filename": "gmyhf_without_downloads_audit.py",
    "source": "\"\"\"只读核验14个无下载数据的全局题号；不发布管理员页面或原文。\"\"\"\nimport sys,json,hashlib,datetime\nfrom pathlib import Path\nsys.path[:0]=[str(Path.cwd()/'scripts'),'/tmp']\nimport oj_submit\nfrom fetch_gmyhf_testdata import DOWNLOAD_LINK,SAFE_FILENAME\nfrom gmyhf_admin_statements_parse import parse_fields\n\ndef run():\n triage=json.loads(Path('collab/gmyhf-pending-triage.json').read_text());manifest=json.loads(Path('data/openjudge/tests/admin_download/manifest.json').read_text())['problems'];entries=[e for e in triage['entries'] if not e.get('downloadable')];assert len(entries)==14\n session=oj_submit.Session().login();rows=[]\n for e in entries:\n  n=e['global_number'];body=session._get(oj_submit.HOST+f'/admin/problems/edit/?id={n}');fields=parse_fields(body);assert len(fields)==6;names=sorted({name for _,pid,name in DOWNLOAD_LINK.findall(body) if int(pid)==n and SAFE_FILENAME.match(name)});snapshot=manifest.get(str(n),{}).get('files',[]);row={'global_number':n,'title':e['title'],'original_reason':e['reason'],'checked_at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'admin_available':True,'field_sha256':{k:hashlib.sha256(v.encode()).hexdigest() for k,v in fields.items()},'live_download_files':names,'snapshot_files':len(snapshot),'status':'no_test_data_available' if not names else 'new_downloads_available','answer_audit':'没有后台测试文件，不能声称答案已验收；保留未接入状态'};rows.append(row);print(n,row['status'],flush=True)\n source=Path(__file__);result={'scope':'14个原无下载题的实时管理员只读核验，不计入359份可下载题的答案验收','entries':rows,'summary':{'checked':len(rows),'still_without_downloads':sum(not x['live_download_files'] for x in rows),'newly_available':sum(bool(x['live_download_files']) for x in rows)},'procedure':{'filename':source.name,'source':source.read_text(),'sha256':hashlib.sha256(source.read_bytes()).hexdigest()}};Path('/tmp/gmyhf-without-downloads-audit.json').write_text(json.dumps(result,ensure_ascii=False,indent=2)+'\\n')\nif __name__=='__main__':run()\n",
    "sha256": "2bf9fe18f19df5822681f1adfb0a74c097bae4cfe3dfa8795cf9ce971ebf97a1"
  }
}
