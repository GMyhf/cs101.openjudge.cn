      "reference_source": "import sys, math, itertools, random, bisect, heapq\nfrom functools import lru_cache\nfrom collections import Counter, defaultdict, deque\nfrom pathlib import Path\n\ndef stocks(text):\n    v = list(map(int, text.split()))\n    n = v[0]\n    rows = [v[1:1 + n], v[1 + n:]]\n    left = [0] * n\n    right = [0] * n\n    for a in rows:\n        low = a[0]\n        best = 0\n        for i in range(n):\n            low = min(low, a[i])\n            best = max(best, a[i] - low)\n            left[i] = max(left[i], best)\n        high = a[-1]\n        best = 0\n        for i in range(n - 1, -1, -1):\n            high = max(high, a[i])\n            best = max(best, high - a[i])\n            right[i] = max(right[i], best)\n    return str(max((a + b for (a, b) in zip(left, right))))\nimport sys\nsys.stdout.write(stocks(sys.stdin.read()) + '\\n')\n",
