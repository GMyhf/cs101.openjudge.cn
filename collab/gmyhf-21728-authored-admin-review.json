        "source": "from decimal import Decimal, localcontext, ROUND_HALF_EVEN\nfrom functools import lru_cache, cmp_to_key\nimport sys\nsys.setrecursionlimit(10000)\ndef waiting(s):\n v=list(map(int,s.split()));n=v[0];times=v[1:1+n];order=v[1+n:];total=sum((n-1-i)*times[x-1] for i,x in enumerate(order))\n return str(Decimal.from_float(total/n).quantize(Decimal('.01'),rounding=ROUND_HALF_EVEN))\n\nsys.stdout.write(waiting(sys.stdin.read()) + \"\\n\")\n",
