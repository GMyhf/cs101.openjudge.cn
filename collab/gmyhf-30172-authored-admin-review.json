        "source": "from decimal import Decimal, localcontext, ROUND_HALF_EVEN\nfrom functools import lru_cache, cmp_to_key\nfrom collections import Counter, defaultdict\nimport heapq\nimport sys\nsys.setrecursionlimit(10000)\ndef galgame(s):\n lines=s.splitlines();n=int(lines[0]);start,end=lines[1].split();graph={end:[]}\n for line in lines[2:]:\n  words=line.split();u=words[0];count=int(words[1]);graph[u]=[(words[2+2*i],int(words[3+2*i])) for i in range(count)]\n nodes=set(graph)|{x for row in graph.values() for x,w in row};color={};order=[]\n # 显式DFS三色检查整个图，包含不可达分量。\n for root in nodes:\n  if color.get(root):continue\n  stack=[(root,False)]\n  while stack:\n   u,leave=stack.pop()\n   if leave:color[u]=2;order.append(u);continue\n   if color.get(u)==2:continue\n   if color.get(u)==1:return 'WRONG INPUT'\n   color[u]=1;stack.append((u,True))\n   for v,w in reversed(graph.get(u,[])):\n    if color.get(v)==1:return 'WRONG INPUT'\n    if color.get(v)!=2:stack.append((v,False))\n best={end:0};choice={}\n for u in order:\n  choices=[(best[v]+w,v) for v,w in graph.get(u,[]) if v in best]\n  if choices:score=max(x[0] for x in choices);best[u]=score;choice[u]=min(v for value,v in choices if value==score)\n if start not in best:return 'WRONG INPUT'\n path=[start]\n while path[-1]!=end:path.append(choice[path[-1]])\n return str(best[start])+'\\n'+' '.join(path)\n\nsys.stdout.write(galgame(sys.stdin.read()) + \"\\n\")\n",
