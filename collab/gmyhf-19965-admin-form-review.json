      "authored_reference": {
        "source": "import math, heapq, random, itertools, re, html\nfrom pathlib import Path\nfrom collections import deque, Counter\nfrom decimal import Decimal, localcontext, ROUND_HALF_EVEN\nfrom fractions import Fraction\n\ndef luffy(s):\n    (a, b, c) = map(int, s.split())\n    while b <= a:\n        need = (a + b - 1) // b\n        if c < need:\n            break\n        c -= need\n        b += a // b\n    return str(b)\nimport sys\nsys.stdout.write(luffy(sys.stdin.read()) + '\\n')\n",
