        "source": "from decimal import Decimal, localcontext, ROUND_HALF_EVEN\nfrom functools import lru_cache, cmp_to_key\nfrom collections import Counter, defaultdict\nimport heapq\nimport sys\nsys.setrecursionlimit(10000)\ndef documents(s):\n lines=s.splitlines();word=lines[0].strip();n,rank=int(lines[1]),int(lines[2]);rows=lines[3:];inverted=defaultdict(list);freq=defaultdict(int)\n for i,row in enumerate(rows,1):\n  tokens=row.split()\n  for token in tokens:freq[token]+=1\n  for token in set(tokens):inverted[token].append(i)\n values=sorted(freq.values(),reverse=True);assert 1<=rank<=len(values);return (' '.join(map(str,inverted[word])) or '-1')+'\\n'+str(values[rank-1])\n\nsys.stdout.write(documents(sys.stdin.read()) + \"\\n\")\n",
