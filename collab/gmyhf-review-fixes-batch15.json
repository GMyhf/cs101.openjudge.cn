      "reference_source": "import math, itertools, random, bisect, heapq\nfrom collections import Counter, deque, defaultdict\nfrom functools import lru_cache\n\ndef shift_tree(text):\n    v = list(map(int, text.split()))\n    (k, n) = v[:2]\n    values = v[2:]\n    nodes = [None if x == -1 else [x, None, None] for x in values]\n    root = nodes[0]\n    q = deque([root])\n    at = 1\n    levels = []\n    while q:\n        row = list(q)\n        q.clear()\n        levels.append(row)\n        for node in row:\n            for child in (1, 2):\n                if at < len(nodes):\n                    node[child] = nodes[at]\n                    at += 1\n                if node[child] is not None:\n                    q.append(node[child])\n    for level in levels[::-1]:\n        slots = [child for node in level for child in node[1:]]\n        amount = k % len(slots)\n        slots = slots[-amount:] + slots[:-amount] if amount else slots\n        for (i, node) in enumerate(level):\n            node[1:] = slots[2 * i:2 * i + 2]\n    output = []\n    q = deque([root])\n    while q:\n        node = q.popleft()\n        output.append(str(node[0]) if node else '-1')\n        if node is not None:\n            q.extend(node[1:])\n    return ' '.join(output)\nimport sys\nsys.stdout.write(shift_tree(sys.stdin.read()) + '\\n')\n",
