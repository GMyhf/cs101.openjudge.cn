  "procedure_source": "import hashlib,json,re,sys\nfrom pathlib import Path\nfrom urllib.error import HTTPError\nsys.path.insert(0,str(Path.cwd()/'scripts'))\nimport sync_gmyhf_followup as p\nroot=Path.cwd();receipt=json.loads(Path('/tmp/gmyhf-31381-retirement/receipt.json').read_text())\ns=p.oj_submit.Session().login();url=p.oj_submit.HOST+'/2026fallcs101testing/E31381/submit/'\ntry:\n with s._opener.open(s._request(url),timeout=60) as response:\n  status=response.status;body=response.read().decode('utf-8','replace')\nexcept HTTPError as exc:\n status=exc.code;body=exc.read().decode('utf-8','replace')\nassert status in (200,403,404),(status,'提交页状态异常')\nassert not re.search(r'name=[\"\\x27]contestId[\"\\x27]',body),'已撤下课程路由仍提供提交表单'\nreceipt['withdrawn_submit_page']={'url':url,'http_status':status,'has_submission_form':False,'body_sha256':hashlib.sha256(body.encode()).hexdigest()}\ncatalog=json.loads((root/'data/openjudge/catalog.json').read_text())\nitems={n:[r for r in catalog['problems'] if int(r.get('global_number') or 0)==n] for n in (31381,27952,28341)}\nassert len(items[31381])==1\nlocal=items[31381][0]\nassert local['book']=='practice' and local['id']=='31381' and local['test_count']==21\nassert local['checker']=='tests/30000-/31381_made/checker.py'\nassert not items[27952] and not items[28341]\npaths=['scripts/retire_gmyhf_31381.py','scripts/materialize_gmyhf_downloads.py','scripts/gmyhf_semantic_checkers.py','tests/test_gmyhf_spj_retirement.py','tests/test_31381_activation.py']\npaths.extend(str(p.relative_to(root)) for p in (root/'data/openjudge/tests/30000-/31381_made').rglob('*') if p.is_file() and '__pycache__' not in p.parts)\nreceipt['local_31381']={'book':local['book'],'id':local['id'],'cases':21,'checker':local['checker'],'active':True}\nreceipt['local_candidates']={str(n):{'enabled':False,'catalog_rows':len(items[n]),'semantic_checker_available':True,'reason':'仅考虑本地SPJ；目前没有公开题库映射，本批不新增题目'} for n in (27952,28341)}\nreceipt['sources_sha256']={name:hashlib.sha256((root/name).read_bytes()).hexdigest() for name in sorted(paths)}\nreceipt['platform_support_decision']='用户确认OpenJudge不支持SPJ；不再等待平台SPJ部署协议。'\nreceipt['scope_limit']='撤下已知测试课程绑定，全局私有题及历史提交未作删除；未宣称提供了平台全局禁用开关。'\nreceipt['procedure_source']=Path(__file__).read_text()\n(root/'collab/gmyhf-spj-platform-retirement.json').write_text(json.dumps(receipt,ensure_ascii=False,indent=2)+'\\n')\nprint('课程',len(receipt['before_mapping']),'->',len(receipt['after_mapping']),'其他绑定保持；旧提交页',status,'无提交表单；本地31381继续启用')\n"
