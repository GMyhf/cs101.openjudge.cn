          "definition": "def valid(text):\n    \"\"\"题面：首行 n（1<=n<=1e5），接着 n 行 \"mi li\"，整数，li>0，m1<m2<...<mn。\"\"\"\n    if not text.endswith(\"\\n\"):\n        return False\n    lines = text[:-1].split(\"\\n\")\n    if not lines[0].isdigit() or lines[0] != str(int(lines[0])):\n        return False\n    n = int(lines[0])\n    if not 1 <= n <= 100000 or len(lines) != n + 1:\n        return False\n    prev = None\n    for row in lines[1:]:\n        tok = row.split(\" \")\n        if len(tok) != 2:\n            return False\n        try:\n            m, l = int(tok[0]), int(tok[1])\n        except ValueError:\n            return False\n        if tok[0] != str(m) or tok[1] != str(l) or l <= 0:\n            return False\n        if prev is not None and m <= prev:\n            return False\n        prev = m\n    return True"
        },
