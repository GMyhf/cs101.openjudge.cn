        "source": "from decimal import Decimal, localcontext, ROUND_HALF_EVEN\nfrom functools import lru_cache, cmp_to_key\nimport sys\nsys.setrecursionlimit(10000)\ndef pedestrian(s):\n v=list(map(int,s.split()));n=v[0];marks=v[1::2];lengths=v[2::2];intervals=[]\n for i,(m,length) in enumerate(zip(marks,lengths)):\n  a,b=m-length,m+length\n  if (i==0 or a>marks[i-1]) and (i==n-1 or b<marks[i+1]):intervals.append((b,a))\n last=None;answer=0\n for right,left in sorted(intervals):\n  if last is None or left>last:answer+=1;last=right\n return str(answer)\n\nsys.stdout.write(pedestrian(sys.stdin.read()) + \"\\n\")\n",
