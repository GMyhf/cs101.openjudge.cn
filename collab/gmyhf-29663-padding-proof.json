  "procedure_source": "\"\"\"对全部待修数据和样例作独立逐位移动复算；不访问平台。\"\"\"\nimport hashlib,json,sys\nfrom pathlib import Path\nsys.path.insert(0,str(Path.cwd()))\nfrom tests.test_gmyhf_padded_tree import reference,slow_shift,shapes,serialize\nfrom scripts.gmyhf_review_fixes import repair_input\nsha=lambda b:hashlib.sha256(b).hexdigest()\nroot=Path.cwd();e=next(e for e in json.loads((root/'collab/gmyhf-pending-batch14-review.json').read_text())['entries'] if e['global_number']==29663)\nsolve=reference();rows=[];small=0\nfor n in range(1,6):\n for shape in shapes(n):\n  values=serialize(shape)\n  while len(values)>=2:\n   for k in (1,2,3,4,5,7,1000):\n    text=f'{k} {len(values)}\\n'+' '.join(map(str,values));assert solve(text)==slow_shift(text);small+=1\n   if values[-1]!=-1:break\n   values.pop()\nfor case in e['checks']['answers']['files']:\n base=root/'data/openjudge/tests/admin_download/29663';given=(base/case['input']).read_bytes();assert sha(given)==case['input_sha256']\n repaired=repair_input(29663,given);answer=solve(repaired.decode());assert answer==slow_shift(repaired.decode())\n rows.append({'input':case['input'],'input_sha256':sha(repaired),'answer_sha256':sha((answer+'\\n').encode()),'matches':True})\nfields=json.loads((root/e['page']).read_text())['fields'];assert solve(fields['sampleInput'])==slow_shift(fields['sampleInput'])==' '.join(fields['sampleOutput'].split())\ns=Path(__file__).read_text();report={'global_number':29663,'rule':'用户确认：补齐每个父节点的左右空位后再循环。空节点不再补孩子；逐层自底向上。','small_cases':small,'data_pairs':rows,'official_samples':1,'all_matched':True,'reference_sha256':e['authored_reference']['sha256'],'independent_simulator_sha256':sha((root/'tests/test_gmyhf_padded_tree.py').read_bytes()),'procedure_source':s,'procedure_sha256':sha(s.encode())}\n(root/'collab/gmyhf-29663-padding-proof.json').write_text(json.dumps(report,ensure_ascii=False,indent=2)+'\\n');print(small,'小树，',len(rows),'实际数据与1样例独立复算通过')\n",
  "procedure_sha256": "5baaf9779d39a21fe00c454df24c11c4b059fbbbc3307e7d3e02c292be7b00db"
