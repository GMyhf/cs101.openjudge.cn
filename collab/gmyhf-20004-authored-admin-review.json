      "authored_reference": {
        "source": "from decimal import Decimal, localcontext, ROUND_HALF_EVEN\nfrom functools import lru_cache, cmp_to_key\nimport sys\nsys.setrecursionlimit(10000)\ndef drawdown(s):\n with localcontext() as ctx:\n  ctx.prec=80;values=[];current=Decimal(1)\n  for x in s.split():current*=1+Decimal(x[:-1])/100;values.append(current)\n  peak=values[0];peak_at=0;best=Decimal(0);start=0;span=0\n  for i,value in enumerate(values):\n   if value>peak:peak=value;peak_at=i\n   drop=(peak-value)/peak\n   if drop>best:best=drop;start=peak_at;span=i-peak_at\n   elif drop==best and best>0 and peak_at==start:span=i-start\n  percent=(-best*100).quantize(Decimal('.1'),rounding=ROUND_HALF_EVEN)\n  return f'{percent if best else Decimal(\"-0.0\"):.1f}% {span}'\n\nsys.stdout.write(drawdown(sys.stdin.read()) + \"\\n\")\n",
        "sha256": "23a5033016a04894f80f333b877cdf52141c642a878f01fd7c3f77add46a860a",
