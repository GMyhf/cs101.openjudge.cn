        "source": "from decimal import Decimal, localcontext, ROUND_HALF_EVEN\nfrom functools import lru_cache, cmp_to_key\nimport sys\nsys.setrecursionlimit(10000)\ndef group_order(s):\n v=list(map(int,s.split()));n,m=v[:2];at=2;groups=[]\n for size in (n,m):\n  atoms=[0]*size;children=[[] for _ in range(size)]\n  for _ in range(size):\n   i,p,z,b=v[at:at+4];at+=4;atoms[i]=z\n   if p>=0:children[p].append((i,b))\n  groups.append((atoms,children))\n # 为两个组的每个节点赋全局编号，递归比较局部序列和最大支链；不拼接长键。\n atoms=groups[0][0]+groups[1][0];children=groups[0][1]+[[(i+n,b) for i,b in row] for row in groups[1][1]]\n @lru_cache(None)\n def compare(a,b):\n  if atoms[a]!=atoms[b]:return 1 if atoms[a]>atoms[b] else -1\n  sa=sorted((atoms[i] for i,bond in children[a] for _ in range(bond)),reverse=True);sb=sorted((atoms[i] for i,bond in children[b] for _ in range(bond)),reverse=True);width=max(len(sa),len(sb));sa+=[0]*(width-len(sa));sb+=[0]*(width-len(sb))\n  if sa!=sb:return 1 if sa>sb else -1\n  if not children[a] and not children[b]:return 0\n  if not children[a]:return -1\n  if not children[b]:return 1\n  ca=max((i for i,_ in children[a]),key=cmp_to_key(compare));cb=max((i for i,_ in children[b]),key=cmp_to_key(compare));return compare(ca,cb)\n return '1' if compare(0,n)>0 else '2'\n\nsys.stdout.write(group_order(sys.stdin.read()) + \"\\n\")\n",
