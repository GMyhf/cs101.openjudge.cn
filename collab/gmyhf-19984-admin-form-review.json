  "scope": "公开题面六字段与当前后台逐项一致（移除公开样例pre包装、仅统一行尾和边缘空白、实体解码一次）；19974的纯文字input、19984的纯文字input/output另精确比对公开br与编辑页实际换行；补齐后台原载荷精确哈希。",
  "platform_writes": 0,
  "procedure_source": "\"\"\"将历史公开题面与当前后台六字段只读核对，绑定后续修复；不修改平台。\"\"\"\nimport copy,html,json,re,sys\nfrom pathlib import Path\nsys.path.insert(0,str(Path.cwd()/'scripts'));import repair_gmyhf_pending_answers as c\nkeys={'描述':'description','输入':'input','输出':'output','提示':'hint','样例输入':'sampleInput','样例输出':'sampleOutput'}\noriginal=Path('collab/gmyhf-pending-batch8-review.json');data=json.loads(original.read_text());session=c.platform.oj_submit.Session().login()\nfor n in (19965,19974,19984):\n e=next(e for e in data['entries'] if e['global_number']==n);page=Path(e['page']).read_bytes();assert c.sha(page)==e['page_sha256']\n section=re.search(r'<dl class=\"problem-content\">(.*?)</dl>',page.decode(),re.S)[1];public={k:'' for k in keys.values()}\n for label,value in re.findall(r'<dt>(.*?)</dt>\\s*<dd>(.*?)</dd>',section,re.S):\n  if label not in keys:continue\n  if value.startswith('<pre>') and value.endswith('</pre>'):value=value[5:-6]\n  public[keys[label]]=value\n live=session._get(c.platform.oj_submit.HOST+f'/admin/problems/edit/?id={n}');fields=c.platform.parse_form(live)\n def canonical(s):return html.unescape(s).replace('\\r\\n','\\n').strip()\n if n==19974:\n  # 此字段为纯文字：公开页用br，编辑页保存实际换行，仅核对此已定位差异。\n  public['input']=public['input'].replace('<br />','\\n')\n if n==19984:\n  for key in ('input','output'):public[key]=public[key].replace('<br />','\\n')\n assert all(canonical(public[k])==canonical(fields[k]) for k in public),[k for k in public if canonical(public[k])!=canonical(fields[k])]\n entry=copy.deepcopy(e);entry['checks']['statement']['field_sha256']={k:c.sha(html.unescape(fields[k]).encode()) for k in public}\n s=Path(__file__).read_text();c.save(Path(f'/tmp/gmyhf-{n}-admin-form-review.json'),{'original_evidence':str(original),'original_evidence_sha256':c.sha(original.read_bytes()),'public_page_sha256':c.sha(page),'scope':'公开题面六字段与当前后台逐项一致（移除公开样例pre包装、仅统一行尾和边缘空白、实体解码一次）；19974的纯文字input、19984的纯文字input/output另精确比对公开br与编辑页实际换行；补齐后台原载荷精确哈希。','platform_writes':0,'procedure_source':s,'procedure_sha256':c.sha(s.encode()),'entries':[entry]})\n print(n,'六字段只读绑定通过',flush=True)\n",
