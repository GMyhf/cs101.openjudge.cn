      "reference_source": "import math, heapq, random, itertools, re, html\nfrom pathlib import Path\nfrom collections import deque, Counter\nfrom decimal import Decimal, localcontext, ROUND_HALF_EVEN\nfrom fractions import Fraction\n\ndef cinema(s):\n    v = iter(map(int, s.split()))\n    out = []\n    for _ in range(next(v)):\n        (m, p, q) = (next(v), next(v), next(v))\n        if m == 0 or (q - p - m) * -m <= 0:\n            out.append('0')\n            continue\n        total = math.comb(p + q, p)\n        r = p + m\n        out.append(str(total - (math.comb(p + q, r) if 0 <= r <= p + q else 0)))\n    return '\\n'.join(out)\nimport sys\nsys.stdout.write(cinema(sys.stdin.read()) + '\\n')\n",
