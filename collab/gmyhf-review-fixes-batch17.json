      "reference_source": "import math, heapq, random, itertools, re, html\nfrom pathlib import Path\nfrom collections import deque, Counter\nfrom decimal import Decimal, localcontext, ROUND_HALF_EVEN\nfrom fractions import Fraction\n\ndef synthesis(s):\n    v = iter(s.split())\n    n = int(next(v))\n    cost = [Fraction(next(v))]\n    route = []\n    for i in range(n):\n        probs = [Fraction(next(v)) for _ in range(i + 1)]\n        options = [((cost[i] + cost[j] + 100 - (1 - p) * cost[i - 1] if i else cost[i] + cost[j] + 100) / p, j) for (j, p) in enumerate(probs) if p > 0]\n        if not options:\n            return 'UNREACHABLE'\n        (best, j) = min(options)\n        cost.append(best)\n        route.append(j)\n    value = cost[-1]\n    (cents, remainder) = divmod(abs(value.numerator) * 100, value.denominator)\n    if 2 * remainder > value.denominator or (2 * remainder == value.denominator and cents % 2):\n        cents += 1\n    price = ('-' if value < 0 and cents else '') + f'{cents // 100}.{cents % 100:02d}'\n    return ' '.join(map(str, route)) + '\\n' + price\nimport sys\nsys.stdout.write(synthesis(sys.stdin.read()) + '\\n')\n",
