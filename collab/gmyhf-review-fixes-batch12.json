      "reference_source": "// 审核用独立算法：坏口味支持集、极大容量盒、支配查询及最小代价排除。\n#include <algorithm>\n#include <array>\n#include <climits>\n#include <functional>\n#include <iostream>\n#include <numeric>\n#include <queue>\n#include <unordered_set>\n#include <vector>\nusing namespace std;\nusing Point=array<long long,8>;\nint N,M,K,adjacency[10],available[8];long long amount[8][10],total[8];\nstruct Hash{size_t operator()(const Point& a)const{size_t h=0;for(auto x:a)h^=hash<long long>{}(x)+0x9e3779b97f4a7c15ULL+(h<<6)+(h>>2);return h;}};\nvector<Point>caps;\nstruct Node{Point low{},high{};int first,left=-1,right=-1;vector<int>ids;};\nvector<Node>tree;\nlong long weight(int i,int mask){long long answer=0;for(int j=0;j<M;++j)if(mask>>j&1)answer+=amount[i][j];return answer;}\nint build(vector<int> ids){\n int at=tree.size();tree.emplace_back();Point low{},high{};\n for(int i=0;i<N;++i){low[i]=LLONG_MAX;high[i]=0;for(int j:ids){low[i]=min(low[i],caps[j][i]);high[i]=max(high[i],caps[j][i]);}}\n tree[at].low=low;tree[at].high=high;tree[at].first=*min_element(ids.begin(),ids.end());\n if(ids.size()<=16){sort(ids.begin(),ids.end());tree[at].ids=move(ids);return at;}\n int axis=0;for(int i=1;i<N;++i)if(high[i]-low[i]>high[axis]-low[axis])axis=i;\n sort(ids.begin(),ids.end(),[&](int a,int b){return caps[a][axis]<caps[b][axis]||(caps[a][axis]==caps[b][axis]&&a<b);});int mid=ids.size()/2;\n int left=build(vector<int>(ids.begin(),ids.begin()+mid));int right=build(vector<int>(ids.begin()+mid,ids.end()));tree[at].left=left;tree[at].right=right;return at;\n}\nint find_box(int at,const Point& c,int best){\n const Node& node=tree[at];if(node.first>=best)return best;bool all=true;\n for(int i=0;i<N;++i){if(node.high[i]<c[i])return best;if(node.low[i]<c[i])all=false;}\n if(all)return node.first;\n if(node.left<0){for(int j:node.ids){if(j>=best)break;bool yes=true;for(int i=0;i<N;++i)if(caps[j][i]<c[i]){yes=false;break;}if(yes)return j;}return best;}\n int left=node.left,right=node.right;if(tree[left].first>tree[right].first)swap(left,right);best=find_box(left,c,best);return find_box(right,c,best);\n}\nlong long margin(const Point& p,const Point& c){long long answer=LLONG_MAX/4;for(int i=0;i<N;++i)if(p[i]<total[i])answer=min(answer,p[i]-c[i]+1);return answer;}\nvoid deepest_box(int at,const Point& c,int& best,long long& depth){\n const Node& node=tree[at];for(int i=0;i<N;++i)if(node.high[i]<c[i])return;\n if(margin(node.high,c)<=depth)return;\n if(node.left<0){for(int j:node.ids){bool yes=true;for(int i=0;i<N;++i)if(caps[j][i]<c[i]){yes=false;break;}if(yes){long long d=margin(caps[j],c);if(d>depth){depth=d;best=j;}}}return;}\n int left=node.left,right=node.right;if(margin(tree[left].high,c)<margin(tree[right].high,c))swap(left,right);deepest_box(left,c,best,depth);deepest_box(right,c,best,depth);\n}\nstruct State{long long cost;Point c;};\nstruct Compare{bool operator()(const State&a,const State&b)const{return a.cost!=b.cost?a.cost>b.cost:a.c>b.c;}};\nint main(){\n ios::sync_with_stdio(false);cin.tie(nullptr);if(!(cin>>N>>M>>K))return 0;\n for(int i=0;i<N;++i)for(int j=0;j<M;++j){cin>>amount[i][j];total[i]+=amount[i][j];if(amount[i][j])available[i]|=1<<j;}\n vector<pair<int,int>> edges;long long upper=LLONG_MAX;\n for(int z=0;z<K;++z){int u,v;cin>>u>>v;--u;--v;edges.emplace_back(u,v);adjacency[u]|=1<<v;adjacency[v]|=1<<u;}\n for(auto [u,v]:edges)for(int i=0;i<N;++i)for(int j=0;j<N;++j)if(i!=j){\n  if(amount[i][u]&&amount[j][v])upper=min(upper,total[i]-amount[i][u]+total[j]-amount[j][v]+2);\n  if(amount[i][v]&&amount[j][u])upper=min(upper,total[i]-amount[i][v]+total[j]-amount[j][u]+2);\n }\n if(upper==LLONG_MAX){cout<<-1<<'\\n';return 0;}\n int free_mask=0;for(int j=0;j<M;++j)if(!adjacency[j])free_mask|=1<<j;\n unordered_set<Point,Hash> unique;\n for(int mask=0;mask<(1<<M);++mask){\n  if((mask&free_mask)!=free_mask)continue;int unseen=mask,isolated=0;vector<int>components;\n  while(unseen){int todo=unseen&-unseen,component=0;while(todo){int bit=todo&-todo;todo^=bit;int u=__builtin_ctz((unsigned)bit);component|=bit;unseen&=~bit;todo|=adjacency[u]&unseen;}\n   if(component&(component-1))components.push_back(component);else isolated|=component;\n  }\n  Point c{};array<int,8> supports{};for(int i=0;i<N;++i){c[i]=weight(i,isolated);supports[i]=isolated&available[i];}\n  function<void(int)> enumerate=[&](int at){\n   if(at==(int)components.size()){\n    int prefix[9]={},suffix[9]={};for(int i=0;i<N;++i)prefix[i+1]=prefix[i]|supports[i];for(int i=N-1;i>=0;--i)suffix[i]=suffix[i+1]|supports[i];\n    for(int i=0;i<N;++i){int missing=available[i]&~supports[i],outside=prefix[i]|suffix[i+1];while(missing){int bit=missing&-missing;missing^=bit;if(!(adjacency[__builtin_ctz((unsigned)bit)]&outside))return;}}\n    unique.insert(c);return;\n   }\n   int component=components[at];for(int i=0;i<N;++i){int old=supports[i];long long add=weight(i,component);supports[i]|=component&available[i];c[i]+=add;enumerate(at+1);c[i]-=add;supports[i]=old;}\n  };enumerate(0);\n }\n caps.assign(unique.begin(),unique.end());unique.clear();sort(caps.begin(),caps.end(),[&](const Point&a,const Point&b){long long x=accumulate(a.begin(),a.begin()+N,0LL),y=accumulate(b.begin(),b.begin()+N,0LL);return x!=y?x<y:a<b;});\n tree.reserve(caps.size()*2);vector<int> ids(caps.size());iota(ids.begin(),ids.end(),0);int root=build(move(ids));priority_queue<State,vector<State>,Compare>queue;unordered_set<Point,Hash>seen;Point zero{};queue.push({0,zero});seen.insert(zero);\n while(!queue.empty()){\n  State state=queue.top();queue.pop();if(state.cost>=upper){cout<<upper<<'\\n';return 0;}int found=-1;long long depth=0;deepest_box(root,state.c,found,depth);if(found<0){cout<<state.cost<<'\\n';return 0;}\n  if(state.cost+depth>=upper)continue;const Point& bad=caps[found];for(int i=0;i<N;++i){if(bad[i]>=total[i])continue;Point next=state.c;next[i]=bad[i]+1;long long cost=state.cost+next[i]-state.c[i];if(cost<upper&&seen.insert(next).second)queue.push({cost,next});}\n }\n cout<<upper<<'\\n';\n}\n",
