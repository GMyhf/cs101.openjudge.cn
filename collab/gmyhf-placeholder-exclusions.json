  "reader_procedure_source": "import hashlib,html,json,re,sys\nfrom datetime import datetime,timezone\nfrom pathlib import Path\nsys.path.insert(0,str(Path.cwd()/'scripts'))\nimport repair_gmyhf_pending_answers as common\ns=common.platform.oj_submit.Session().login();root=Path.cwd()\nold=json.loads((root/'collab/gmyhf-without-downloads-review.json').read_text())\nrecords=[]\nfor item in old['entries']:\n n=item['global_number'];page=s._get(common.platform.oj_submit.HOST+f'/admin/problems/edit/?id={n}')\n fields=common.platform.parse_form(page);assert fields['problemId']==str(n)\n Path(f'/tmp/gmyhf-empty-role-{n}.html').write_text(page)\n links=re.findall(r'href=\"(/admin/download[^\\\"]*)\"',page)\n visible={k:' '.join(html.unescape(re.sub(r'<[^>]+>',' ',fields.get(k,''))).split()) for k in ('title','description','input','output','hint','sampleInput','sampleOutput')}\n print(n,json.dumps(visible,ensure_ascii=False)[:2500],flush=True)\n records.append({'global_number':n,'fields':visible,'download_links':links,'form_sha256':common.form_sha(page),'field_sha256':{k:common.sha(v.encode()) for k,v in fields.items() if k in visible}})\nPath('/tmp/gmyhf-empty-role-live.json').write_text(json.dumps({'checked_at':datetime.now(timezone.utc).isoformat(),'entries':records},ensure_ascii=False,indent=2)+'\\n')\n",
  "verification_procedure_source": "import hashlib,json,sys\nfrom datetime import datetime,timezone\nfrom pathlib import Path\nsys.path.insert(0,str(Path.cwd()/'scripts'))\nimport repair_gmyhf_pending_answers as common\nfrom materialize_gmyhf_downloads import MANUAL_EXCLUSIONS\nroot=Path.cwd();live=json.loads(Path('/tmp/gmyhf-empty-role-live.json').read_text())\nretired={28979:'test_placeholder',31195:'explicitly_to_remove',31248:'placeholder_template'}\nalgorithms={27207,29337,29893,29894,31200};benchmarks=set(range(31028,31033));demos={31178}\nall_ids={e['global_number'] for e in live['entries']}\nassert set(retired)|algorithms|benchmarks|demos==all_ids\nassert len(all_ids)==14\ns=common.platform.oj_submit.Session().login();entries=[]\ncatalog=json.loads((root/'data/openjudge/catalog.json').read_text())\nfor e in live['entries']:\n n=e['global_number'];page=s._get(common.platform.oj_submit.HOST+f'/admin/problems/edit/?id={n}')\n assert common.form_sha(page)==e['form_sha256'],(n,'只读期间表单变化')\n try:\n  names=common.listed_files(page,n)\n except ValueError as exc:\n  if str(exc)!='未获得文件清单':raise\n  names=[]\n assert not names,(n,'已新增数据，须重审')\n f=e['fields'];item={'global_number':n,'title':f['title'],'form_sha256':e['form_sha256'],'field_sha256':e['field_sha256'],'live_download_files':[], 'form_unchanged':True}\n if n in retired:\n  assert n in MANUAL_EXCLUSIONS\n  if n==28979:assert f['title']==f['description']=='test60' and f['input']==f['output']=='test'\n  elif n==31195:assert '(to remove)' in f['title']\n  else:assert f['title']=='占位' and (f['description'],f['input'],f['output'])==('desc','input','output')\n  matches=[r for r in catalog['problems'] if int(r.get('global_number') or 0)==n]\n  assert not any(r.get('tests') or r.get('test_cases') for r in matches)\n  item.update(disposition=retired[n],decision='按用户选择固定排除，不因未来补数据或映射自动启用',exclusion_reason=MANUAL_EXCLUSIONS[n],local_enabled=False)\n  item['evidence']={k:f[k] for k in (('title','description','input','output') if n!=31195 else ('title',))}\n else:\n  assert n not in MANUAL_EXCLUSIONS,(n,'误将其余题列为废弃')\n  item.update(disposition='algorithm_problem' if n in algorithms else 'io_benchmark' if n in benchmarks else 'function_demonstration',decision='本批不认定为占位或废弃；维持原无数据排除，不新增数据或绑定')\n entries.append(item)\npaths=['scripts/materialize_gmyhf_downloads.py','tests/test_gmyhf_placeholder_exclusions.py','collab/gmyhf-without-downloads-review.json','collab/gmyhf-placeholder-exclusions-mutations.json']\nreport={'checked_at':datetime.now(timezone.utc).isoformat(),'scope':'用户选择第1项：核实14个无下载题中的占位与明确待移除题，并固定排除；不执行补自产数据或特殊题启用。','summary':{'reviewed':14,'fixed_excluded':sorted(retired),'algorithm_problems_not_retired':sorted(algorithms),'benchmarks_not_retired':sorted(benchmarks),'demonstrations_not_retired':sorted(demos),'still_without_downloads':14,'platform_writes':0,'new_data_pairs':0,'activated_problems':0},'entries':entries,'sources_sha256':{p:hashlib.sha256((root/p).read_bytes()).hexdigest() for p in paths},'reader_procedure_source':Path('/tmp/review_gmyhf_empty_problem_roles.py').read_text(),'verification_procedure_source':Path(__file__).read_text()}\n(root/'collab/gmyhf-placeholder-exclusions.json').write_text(json.dumps(report,ensure_ascii=False,indent=2)+'\\n')\nprint(json.dumps(report['summary'],ensure_ascii=False))\n"
}
