        "source": "from decimal import Decimal, localcontext, ROUND_HALF_EVEN\nfrom functools import lru_cache, cmp_to_key\nfrom collections import Counter, defaultdict\nimport heapq\nimport sys\nsys.setrecursionlimit(10000)\ndef plank(s):\n v=s.split();H,L,n=map(int,v[:3]);speeds=[Decimal(x) for x in v[3:]]\n # 快于阈值的球最多floor((n-1)/2)个：选速度中的上中位数。\n \n # 需拦截floor(n/2)+1个，允许提前通过n-floor(n/2)-1个。\n speed=sorted(speeds,reverse=True)[n-(n//2+1)]\n with localcontext() as ctx:\n  ctx.prec=60;height=max(Decimal(0),Decimal(H)-5*(Decimal(L)/speed)**2);return format(height.quantize(Decimal('.01'),rounding=ROUND_HALF_EVEN),'.2f')\n\nsys.stdout.write(plank(sys.stdin.read()) + \"\\n\")\n",
