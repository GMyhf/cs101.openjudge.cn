        "source": "from decimal import Decimal, localcontext, ROUND_HALF_EVEN\nfrom functools import lru_cache, cmp_to_key\nimport sys\nsys.setrecursionlimit(10000)\ndef bricks(s):\n v=list(map(int,s.split()));n,M=v[:2];dp=[-10**9]*(M+1);dp[0]=0\n for x in v[2:]:\n  for j in range(M,x-1,-1):dp[j]=max(dp[j],dp[j-x]+1)\n return str(max(dp))\n\nsys.stdout.write(bricks(sys.stdin.read()) + \"\\n\")\n",
