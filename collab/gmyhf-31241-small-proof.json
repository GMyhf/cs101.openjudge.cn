  "procedure_source": "\"\"\"自写C++参考与所有实际抽取结果穷举对拍；不读取平台数据。\"\"\"\nimport hashlib,itertools,json,random,subprocess,tempfile\nfrom pathlib import Path\nroot=Path.cwd();e=next(e for e in json.loads((root/'collab/gmyhf-pending-batch10-review.json').read_text())['entries'] if e['global_number']==31241)\nsource=e['authored_reference']['source'];assert hashlib.sha256(source.encode()).hexdigest()==e['authored_reference']['sha256']\ndef brute(rows,edges):\n n=len(rows);m=len(rows[0]);bad=set()\n for draws in itertools.product(*(range(v+1) for r in rows for v in r)):\n  c=tuple(sum(draws[i*m:(i+1)*m]) for i in range(n))\n  if not any(draws[i*m+u] and draws[j*m+v] for i in range(n) for j in range(n) if i!=j for a,b in edges for u,v in ((a,b),(b,a))):bad.add(c)\n valid=[sum(c) for c in itertools.product(*(range(sum(r)+1) for r in rows)) if c not in bad]\n return min(valid,default=-1)\npatterns=list(itertools.product((0,1),repeat=3))[1:];pairs=list(itertools.combinations(range(3),2));cases=[]\nfor rows in itertools.product(patterns,repeat=2):\n for mask in range(1,8):cases.append((rows,[p for i,p in enumerate(pairs) if mask>>i&1]))\nrng=random.Random(31241)\nfor _ in range(50):\n rows=[tuple(rng.randrange(2) for j in range(4)) for i in range(3)]\n if not all(map(any,rows)):continue\n edges=[p for p in itertools.combinations(range(4),2) if rng.randrange(2)]\n if edges:cases.append((rows,edges))\nreceipts=[]\nwith tempfile.TemporaryDirectory(prefix='gmyhf-31241-small-') as work:\n work=Path(work);src=work/'reference.cpp';src.write_text(source);exe=work/'reference'\n subprocess.run(['g++','-std=c++17','-O2',str(src),'-o',str(exe)],check=True,capture_output=True,timeout=120)\n for rows,edges in cases:\n  text=f'{len(rows)} {len(rows[0])} {len(edges)}\\n'+'\\n'.join(' '.join(map(str,r)) for r in rows)+'\\n'+'\\n'.join(f'{u+1} {v+1}' for u,v in edges)+'\\n'\n  expected=brute(rows,edges);result=subprocess.run([str(exe)],input=text.encode(),capture_output=True,check=True,timeout=10);actual=int(result.stdout)\n  assert expected==actual,(rows,edges,expected,actual)\n  receipts.append({'input_sha256':hashlib.sha256(text.encode()).hexdigest(),'answer':actual})\ns=Path(__file__).read_text();r={'global_number':31241,'reference_sha256':e['authored_reference']['sha256'],'cases':len(cases),'all_matched':True,'checks':receipts,'procedure_source':s,'procedure_sha256':hashlib.sha256(s.encode()).hexdigest()}\nPath('/tmp/gmyhf-31241-small-proof.json').write_text(json.dumps(r,ensure_ascii=False,indent=2)+'\\n');print(len(cases),'组独立抽取枚举对拍通过')\n",
