        "source": "from decimal import Decimal, localcontext, ROUND_HALF_EVEN\nfrom functools import lru_cache, cmp_to_key\nimport sys\nsys.setrecursionlimit(10000)\ndef entropy(s):\n v=s.split();p=[Decimal(x) for x in v[1:]];assert len(p)==int(v[0]);lo=p.index(min(p));hi=max((i for i in range(len(p)) if i!=lo),key=lambda i:p[i])\n with localcontext() as ctx:\n  ctx.prec=60;ln2=Decimal(2).ln();terms=[-x*x.ln()/ln2 if x else Decimal(0) for x in p];return '\\n'.join(format(x.quantize(Decimal('.001'),rounding=ROUND_HALF_EVEN),'.3f') for x in (sum(terms),sum(x for i,x in enumerate(terms) if i not in (lo,hi))))\n\nsys.stdout.write(entropy(sys.stdin.read()) + \"\\n\")\n",
