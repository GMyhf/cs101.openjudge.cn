      "reference_source": "import math, itertools, random, heapq, bisect, ast\nfrom collections import Counter, deque\nfrom functools import lru_cache\n\ndef settle(board):\n    columns = [list(row) for row in board]\n    while True:\n        removed = set()\n        for (x, col) in enumerate(columns):\n            for (y, color) in enumerate(col):\n                if y + 2 < len(col) and col[y + 1] == color == col[y + 2]:\n                    end = y + 3\n                    while end < len(col) and col[end] == color:\n                        end += 1\n                    removed.update(((x, j) for j in range(y, end)))\n                if x + 2 < 5 and y < len(columns[x + 1]) and (y < len(columns[x + 2])) and (columns[x + 1][y] == color == columns[x + 2][y]):\n                    end = x + 3\n                    while end < 5 and y < len(columns[end]) and (columns[end][y] == color):\n                        end += 1\n                    removed.update(((i, y) for i in range(x, end)))\n        if not removed:\n            return tuple((tuple(row) for row in columns))\n        columns = [[v for (y, v) in enumerate(col) if (x, y) not in removed] for (x, col) in enumerate(columns)]\n\ndef mayan(text):\n    lines = text.splitlines()\n    steps = int(lines[0])\n    initial = tuple((tuple(map(int, line.split()))[:-1] for line in lines[1:]))\n\n    @lru_cache(None)\n    def visit(board, left):\n        if not left:\n            return () if not any(board) else None\n        counts = Counter((v for row in board for v in row))\n        if any((v < 3 for v in counts.values())):\n            return None\n        for (x, col) in enumerate(board):\n            for y in range(len(col)):\n                for direction in (1, -1):\n                    z = x + direction\n                    if not 0 <= z < 5:\n                        continue\n                    moved = [list(row) for row in board]\n                    if y < len(moved[z]):\n                        (moved[x][y], moved[z][y]) = (moved[z][y], moved[x][y])\n                    else:\n                        moved[z].append(moved[x].pop(y))\n                    nxt = settle(moved)\n                    tail = visit(nxt, left - 1)\n                    if tail is not None:\n                        return ((x, y, direction),) + tail\n        return None\n    result = visit(initial, steps)\n    return '-1' if result is None else '\\n'.join((' '.join(map(str, row)) for row in result))\nimport sys\nsys.stdout.write(mayan(sys.stdin.read()) + '\\n')\n",
