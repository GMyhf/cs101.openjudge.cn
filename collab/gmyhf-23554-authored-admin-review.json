          "source": "import sys, math\nfrom collections import deque\nP = 23554\n\ndef solve(s):\n    a = s.split()\n    n = int(a[0])\n    v = list(map(int, a[1:]))\n    return ' '.join(map(str, sorted(set(range(1, n + 1)) - set(v)))) + '\\n' + ' '.join(map(str, sorted((x for x in v if x > n)))) + '\\n'\nsys.stdout.write(solve(sys.stdin.read()))\n",
