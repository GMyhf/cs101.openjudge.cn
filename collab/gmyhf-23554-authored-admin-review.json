          "definition": "def valid(text):\n    \"\"\"题面契约：两行；第一行 n（1<=n<=200）；第二行若干空格分隔整数，本班编号 1..n（互不重复），\n    他班编号 n+1..10000（可重复）；保证走丢的和乱入的都至少有一个。\"\"\"\n    if not text.endswith(\"\\n\"):\n        return False\n    lines = text[:-1].split(\"\\n\")\n    if len(lines) != 2:\n        return False\n    try:\n        if lines[0].strip() != lines[0] or not lines[0].isdigit():\n            return False\n        n = int(lines[0])\n        toks = lines[1].split(\" \")\n        if any(not t.isdigit() for t in toks):\n            return False\n        v = [int(t) for t in toks]\n    except ValueError:\n        return False\n    if not 1 <= n <= 200:\n        return False\n    if any(x < 1 or x > 10000 for x in v):\n        return False\n    inside = [x for x in v if x <= n]\n    outside = [x for x in v if x > n]\n    if len(set(inside)) != len(inside):\n        return False\n    return len(inside) < n and len(outside) >= 1"
        },
