        "source": "from decimal import Decimal, localcontext, ROUND_HALF_EVEN\nfrom functools import lru_cache, cmp_to_key\nfrom collections import Counter, defaultdict\nimport heapq\nimport sys\nsys.setrecursionlimit(10000)\ndef outing(s):\n v=list(map(int,s.split()));n=v[0];seen=Counter(v[1:]);missing=[str(i) for i in range(1,n+1) if not seen[i]];outside=list(heapq.merge(*([x]*count for x,count in sorted(seen.items()) if x>n)))\n return ' '.join(missing)+'\\n'+' '.join(map(str,outside))\n\nsys.stdout.write(outing(sys.stdin.read()) + \"\\n\")\n",
