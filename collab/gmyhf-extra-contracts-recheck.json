  "tests_sha256": "6108823f657322dda198f9e2668a0b61657ea2caa83bea4642277596c9bb20f7",
  "procedure_source": "\"\"\"原题面契约与后台字节只读复核；不更改既有valid()或接入状态。\"\"\"\nimport hashlib,html,json,re,sys\nfrom pathlib import Path\nROOT=Path.cwd();sys.path.insert(0,str(ROOT));sys.path.insert(0,str(ROOT/'scripts'))\nfrom tests.test_gmyhf_contract_recheck import statement_contract\nimport repair_gmyhf_pending_answers as c\nsession=c.platform.oj_submit.Session().login();groups=[]\nreasons={25570:'四份矩阵仅多出尾部空行，全部矩阵维数及数值合法。',28013:'题面允许互异整数，零值合法；正值要求是生成器额外约束。',30930:'仅多出尾部空行，N及全部发言次数合法。'}\nkeys={'描述':'description','输入':'input','输出':'output','提示':'hint','样例输入':'sampleInput','样例输出':'sampleOutput'}\ndef canonical(s):return re.sub(r'<br\\s*/?>','\\n',html.unescape(s)).replace('\\xa0',' ').replace('\\r\\n','\\n').strip()\nfor n,batch in [(25570,5),(28013,6),(30930,6)]:\n evidence=ROOT/f'collab/gmyhf-pending-batch{batch}-review.json';entry=next(e for e in json.loads(evidence.read_text())['entries'] if e['global_number']==n)\n public=(ROOT/entry['page']).read_bytes();assert c.sha(public)==entry['page_sha256']\n page=session._get(c.platform.oj_submit.HOST+f'/admin/problems/edit/?id={n}');fields=c.platform.parse_form(page);public_fields={k:'' for k in keys.values()}\n section=re.search(r'<dl class=\"problem-content\">(.*?)</dl>',public.decode(),re.S)[1]\n for label,value in re.findall(r'<dt>(.*?)</dt>\\s*<dd>(.*?)</dd>',section,re.S):\n  if label in keys:public_fields[keys[label]]=value[5:-6] if value.startswith('<pre>') and value.endswith('</pre>') else value\n assert all(canonical(public_fields[key])==canonical(fields[key]) for key in public_fields)\n baseline={r['filename']:r['sha256'] for r in entry['checks']['readback']['files']};names=c.listed_files(page,n)\n assert {name for name in names if name.endswith(('.in','.out'))}=={name for name in baseline if name.endswith(('.in','.out'))}\n readback={}\n for name in names:\n  payload=c.platform.download(session,n,name);digest=c.sha(payload)\n  if name in baseline:assert digest==baseline[name],(n,name)\n  readback[name]=digest\n checks=[]\n for record in entry['checks']['answers']['files']:\n  payload=(ROOT/f'data/openjudge/tests/admin_download/{n}'/record['input']).read_bytes()\n  assert c.sha(payload)==record['input_sha256']==readback[record['input']]\n  assert statement_contract(n,payload),(n,record['input'])\n  checks.append({'input':record['input'],'sha256':c.sha(payload),'statement_contract_passed':True})\n final=session._get(c.platform.oj_submit.HOST+f'/admin/problems/edit/?id={n}');assert c.form_sha(page)==c.form_sha(final) and c.listed_files(final,n)==names\n groups.append({'global_number':n,'evidence':str(evidence.relative_to(ROOT)),'evidence_sha256':c.sha(evidence.read_bytes()),'verdict':reasons[n],'checks':checks,'readback_files':readback,'form_sha256':c.form_sha(page),'public_statement_matches_admin':True,'platform_writes':0,'preserve_existing_validator_and_exclusion':True})\n print(n,'题面契约及全文件只读回读通过',len(checks),len(readback),flush=True)\ns=Path(__file__).read_text();c.save(ROOT/'collab/gmyhf-extra-contracts-recheck.json',{'scope':'仅确认原拒绝来自生成器额外范围或尾部空白；不声明新接入或沙箱Accepted。','platform_writes':0,'problems':groups,'tests_sha256':c.sha((ROOT/'tests/test_gmyhf_contract_recheck.py').read_bytes()),'procedure_source':s,'procedure_sha256':c.sha(s.encode())})\n",
  "procedure_sha256": "56ecfe369d83a311c455caea25c891a9577082303117e18f797a8f52d8787642"
