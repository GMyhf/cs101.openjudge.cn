  "resolution": "原第一样例含尾部分隔空行，旧证书解析器把它当成额外回合而拒绝；去除分隔后原棋盘和三步日志合法。原误报的未连吃描述不成立，保留原题面及数据。",
  "selfchecks": 8,
  "procedure_source": "\"\"\"只读复核跳棋证书与样例分隔；坐标字典模拟，独立于原一维棋盘参考。\"\"\"\nimport hashlib,html,json,re,sys\nfrom pathlib import Path\nsys.path.insert(0,str(Path.cwd()/'scripts'));import repair_gmyhf_pending_answers as c\nTILES=[(r,col) for r in range(8) for col in range(8) if (r+col)%2]\n\ndef jumps(board,p):\n piece=board[p];drs=(-1,1) if piece.isupper() else (1,) if piece=='b' else (-1,)\n result={}\n for dr in drs:\n  for dc in (-1,1):\n   mid=(p[0]+dr,p[1]+dc);end=(p[0]+2*dr,p[1]+2*dc)\n   if end in TILES and end not in board and mid in board and board[mid].lower()!=piece.lower():result[end]=mid\n return result\n\ndef valid(text,answer):\n try:\n  output=[r.split() for r in answer.strip().splitlines()]\n  if len(output)!=8 or any(len(r)!=2 or any(len(s)!=8 for s in r) for r in output):return False\n  boards=[]\n  for side in (0,1):\n   board={}\n   for r in range(8):\n    for col in range(8):\n     v=output[r][side][col]\n     if (r,col) not in TILES:\n      if v!='-':return False\n     elif v!='.':\n      if v not in 'bBwW':return False\n      board[r,col]=v\n   boards.append(board)\n  board,finish=boards\n  if any(piece=='b' and r==7 or piece=='w' and r==0 for (r,col),piece in board.items()):return False\n  logs=text.strip().splitlines();turn,count=logs[0].split()\n  if turn not in ('W','B') or len(logs)-1!=int(count):return False\n  for log in logs[1:]:\n   capture='x' in log\n   if not re.fullmatch(r'\\d+(?:x\\d+)+' if capture else r'\\d+-\\d+',log):return False\n   labels=[int(x) for x in re.split('[x-]',log)]\n   if any(not 1<=x<=32 for x in labels):return False\n   path=[TILES[x-1] for x in labels];p=path[0]\n   if p not in board or board[p].lower()!=turn.lower():return False\n   if not capture and any(jumps(board,q) for q in board if board[q].lower()==turn.lower()):return False\n   promoted=False\n   for i,q in enumerate(path[1:]):\n    if q in board:return False\n    piece=board[p]\n    if capture:\n     options=jumps(board,p)\n     if q not in options:return False\n     del board[options[q]]\n    else:\n     dr=q[0]-p[0];dc=q[1]-p[1]\n     if abs(dr)!=1 or abs(dc)!=1 or piece=='b' and dr!=1 or piece=='w' and dr!=-1:return False\n    del board[p];board[q]=piece;p=q\n    if piece=='b' and q[0]==7 or piece=='w' and q[0]==0:\n     if i!=len(path)-2:return False\n     board[q]=piece.upper();promoted=True\n   if capture and not promoted and jumps(board,p):return False\n   turn='B' if turn=='W' else 'W'\n  return board==finish\n except (ValueError,KeyError,IndexError,TypeError):return False\n\ndef render(a,b):\n return '\\n'.join(' '.join(''.join(board.get((r,col),'.') if (r,col) in TILES else '-' for col in range(8)) for board in (a,b)) for r in range(8))\n\ndef selfcheck():\n start={(4,1):'W',(3,2):'b',(1,4):'b'};mid={(2,3):'W',(1,4):'b'};end={(0,5):'W'}\n label=lambda p:str(TILES.index(p)+1)\n short='W 1\\n'+label((4,1))+'x'+label((2,3))\n full=short+'x'+label((0,5))\n assert valid(full,render(start,end))\n assert not valid(short,render(start,mid))\n assert not valid('W 2\\n'+full.splitlines()[1],render(start,end))\n # 白兵吃到升变线后立即停，不按新王继续回跳。\n a={(2,1):'w',(1,2):'b',(1,4):'b'};b={(0,3):'W',(1,4):'b'}\n promotion='W 1\\n'+label((2,1))+'x'+label((0,3))\n assert valid(promotion,render(a,b))\n assert not valid(full,render(start,mid))\n assert not valid(full.replace('W 1','B 1'),render(start,end))\n a=dict(start);a[6,1]='w';b=dict(a);del b[6,1];b[5,0]='w'\n normal='W 1\\n'+label((6,1))+'-'+label((5,0))\n assert not valid(normal,render(a,b))\n a={(2,3):'w',(3,4):'b'};b={(4,5):'w'}\n backwards='W 1\\n'+label((2,3))+'x'+label((4,5))\n assert not valid(backwards,render(a,b))\n return 8\n\ndef run():\n root=Path.cwd();evidence=root/'collab/gmyhf-pending-batch16-review.json';entry=next(e for e in json.loads(evidence.read_text())['entries'] if e['global_number']==30549)\n snapshot=Path(entry['page']);assert c.sha(snapshot.read_bytes())==entry['page_sha256'];fields=json.loads(snapshot.read_text())['fields']\n assert {k:c.sha(v.encode()) for k,v in fields.items()}==entry['checks']['statement']['field_sha256']\n proof=entry['authored_reference'];assert c.sha(proof['source'].encode())==proof['sha256'];ns={'__name__':'audit'};exec(proof['source'],ns)\n inputs=re.split(r'样例输入\\s*[12]\\s*',fields['sampleInput'].replace('\\r\\n','\\n').strip())[1:];outputs=re.split(r'样例输出\\s*[12]\\s*',fields['sampleOutput'].replace('\\r\\n','\\n').strip())[1:];assert len(inputs)==len(outputs)==2\n samples=[]\n for i,(given,want,check) in enumerate(zip(inputs,outputs,entry['checks']['answers']['official_sample_checks']),1):\n  assert c.sha(want.encode())==check['statement_output_sha256']\n  assert valid(given,want) and ns['checker_certificate'](given.strip(),want.strip())\n  samples.append({'index':i,'normalized_input_sha256':c.sha(given.strip().encode()),'normalized_output_sha256':c.sha(want.strip().encode()),'independent_valid':True,'original_checker_with_separator':ns['checker_certificate'](given.replace('\\r\\n','\\n'),want.replace('\\r\\n','\\n'))})\n assert samples[0]['original_checker_with_separator']==False\n session=c.platform.oj_submit.Session().login();page=session._get(c.platform.oj_submit.HOST+'/admin/problems/edit/?id=30549');c.audit_statement(page,entry);fingerprint=c.form_sha(page)\n names=c.listed_files(page,30549);baseline={r['filename']:r['sha256'] for r in entry['checks']['readback']['files']};assert names==sorted(baseline)\n checked={}\n for name in names:\n  live=c.platform.download(session,30549,name);assert c.sha(live)==baseline[name];checked[name]=c.sha(live)\n pairs=[]\n for record in entry['checks']['answers']['files']:\n  base=root/'data/openjudge/tests/admin_download/30549';given=(base/record['input']).read_bytes();want=(base/record['output']).read_bytes()\n  assert c.sha(given)==checked[record['input']] and c.sha(want)==checked[record['output']]\n  assert valid(given.decode(),want.decode()),record['input']\n  pairs.append({'input':record['input'],'input_sha256':c.sha(given),'output_sha256':c.sha(want),'independent_valid':True})\n page=session._get(c.platform.oj_submit.HOST+'/admin/problems/edit/?id=30549');assert c.form_sha(page)==fingerprint and c.listed_files(page,30549)==names\n s=Path(__file__).read_text();report={'global_number':30549,'original_evidence':str(evidence.relative_to(root)),'original_evidence_sha256':c.sha(evidence.read_bytes()),'original_reference_sha256':proof['sha256'],'samples':samples,'certificate_pairs':len(pairs),'checks':pairs,'readback_files':checked,'form_unchanged':True,'platform_writes':0,'resolution':'原第一样例含尾部分隔空行，旧证书解析器把它当成额外回合而拒绝；去除分隔后原棋盘和三步日志合法。原误报的未连吃描述不成立，保留原题面及数据。','selfchecks':selfcheck(),'procedure_source':s,'procedure_sha256':c.sha(s.encode())}\n c.save(Path('/tmp/gmyhf-30549-certificate-recheck.json'),report);print('30549 两样例及',len(pairs),'组独立证书模拟通过；',len(checked),'文件只读回读一致，零写入')\nif __name__=='__main__':run()\n",
  "procedure_sha256": "da6e7b8bbd496947373728b6ccc493a5fe978b6fa4a161f36d35faf54609ffcb"
}
