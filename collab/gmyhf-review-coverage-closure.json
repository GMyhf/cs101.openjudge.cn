  "procedure_source": "import copy\nimport hashlib\nimport json\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nroot = Path.cwd()\nsources = {}\ndef read(name):\n    path = root / 'collab' / (name + '.json')\n    sources[str(path.relative_to(root))] = hashlib.sha256(path.read_bytes()).hexdigest()\n    return json.loads(path.read_text())\n\nfollowup = read('gmyhf-download-followup')\ngroups = {\n    'early_independent': [e['global_number'] for e in followup['entries']\n                          if e['answer_review'].startswith('独立逐文件核对')],\n    'remaining_materialized': [e['global_number'] for e in read('gmyhf-rest-acceptance')['entries']],\n    '28912_special_review': [e['global_number'] for e in read('gmyhf-followup-repairs')['verification']['independent']\n                             if e['global_number'] == 28912],\n    'pending_batches': [],\n    'without_downloads': [e['global_number'] for e in read('gmyhf-without-downloads-review')['entries']],\n}\nfor batch in range(1, 17):\n    groups['pending_batches'].extend(e['global_number'] for e in read(f'gmyhf-pending-batch{batch}-review')['entries'])\n\nownership = json.loads(Path('/tmp/gmyhf-current-ownership-coverage.json').read_text())\ndef validate(candidate, current):\n    seen = set()\n    for name, ids in candidate.items():\n        if len(ids) != len(set(ids)):\n            raise ValueError('组内题号重复: ' + name)\n        if seen.intersection(ids):\n            raise ValueError('跨组题号重复: ' + name)\n        seen.update(ids)\n    if seen != set(current):\n        raise ValueError('后台题号覆盖不一致')\n\nvalidate(groups, ownership['current'])\nmanifest = json.loads((root / 'data/openjudge/tests/admin_download/manifest.json').read_text())\ndownloadable = {int(n) for n, e in manifest['problems'].items() if e.get('files')}\ncovered_downloadable = set().union(*(set(v) for k, v in groups.items() if k != 'without_downloads'))\nif downloadable != covered_downloadable:\n    raise ValueError('有下载数据的题号覆盖不一致')\nif ownership['added'] or ownership['removed']:\n    raise ValueError('后台题号已变化，须先增补审核')\n\nmutations = []\nfor label in ['漏题', '组内重复', '跨组重复', '意外题号']:\n    bad = copy.deepcopy(groups)\n    n = bad['early_independent'][0]\n    if label == '漏题':\n        bad['early_independent'].pop(0)\n    elif label == '组内重复':\n        bad['early_independent'].append(n)\n    elif label == '跨组重复':\n        bad['pending_batches'].append(n)\n    else:\n        bad['early_independent'][0] = -1\n    try:\n        validate(bad, ownership['current'])\n    except ValueError as exc:\n        mutations.append({'mutation': label, 'rejected': True, 'reason': str(exc)})\n    else:\n        raise ValueError('未检出覆盖变异: ' + label)\n\nreport = {\n    'checked_at': datetime.now(timezone.utc).isoformat(),\n    'scope': '仅核对审核记录覆盖范围；不重新声称全部数据正确、全部沙箱Accepted或全部可接入。',\n    'live_ownership': ownership,\n    'summary': {**{k: len(v) for k, v in groups.items()},\n                'reviewed_downloadable': len(covered_downloadable), 'total_accounted': sum(map(len, groups.values())),\n                'missing': [], 'duplicates': [], 'new_live_problems': []},\n    'groups': {k: sorted(v) for k, v in groups.items()},\n    'sources': sources,\n    'remaining_holds': read('gmyhf-review-fixes-summary')['remaining_holds'],\n    'limitations': [\n        '历史原始报告保留当时发现；后续修复或误报更正以review-fixes-summary及post_review_updates为准。',\n        '359题的原始结论为60题review_passed、299题review_hold；覆盖完成不改变接入判据。',\n        '14题无下载数据，只能确认无可审核文件；不声称答案正确。',\n        '31381本地已启用，远端SPJ误接受仍待平台修复；27952/28341仍缺公开题库映射及平台SPJ协议。',\n        '资源限制、既有valid及题库映射排除保持；19945/20139按用户决定永久排除。',\n        '本批无平台写入、数据修复或新增题库绑定；前20批修复累计数保持。',\n    ],\n    'coverage_mutations': mutations,\n    'procedure_source': Path(__file__).read_text(),\n}\nreport['sources'] = sources\nout = root / 'collab/gmyhf-review-coverage-closure.json'\nout.write_text(json.dumps(report, ensure_ascii=False, indent=2) + '\\n')\nprint(json.dumps(report['summary'], ensure_ascii=False))\n"
