  "tests_sha256": "0c2d307dbbe17f9fa0c7e4cd448be33164a4899bce4b1e48ec5280db9a1c5e31",
  "rules_sha256": "a487a5346325f22d9c7695914c61e01cf795799837d68141ca958a953b01412a",
  "procedure_source": "\"\"\"独立可达状态图、原自产Python及C++三方小域校核；实际图用Kahn复算。\"\"\"\nimport ast,collections,hashlib,heapq,json,sys\nfrom pathlib import Path\nROOT=Path.cwd();sys.path.insert(0,str(ROOT))\nfrom tests.test_gmyhf_graph_and_swap import swap_cases,cpp_answers,wide_cpp_source\nsha=lambda b:hashlib.sha256(b).hexdigest()\nproof=json.loads((ROOT/'collab/gmyhf-27699-authored-admin-review.json').read_text())['entries'][0]['authored_reference']\nsource=proof['original_python_source'];assert sha(source.encode())==proof['original_python_sha256'];tree=ast.parse(source);tree.body=[node for node in tree.body if isinstance(node,(ast.FunctionDef,ast.Import,ast.ImportFrom))];namespace={};exec(compile(tree,'<原审核自产Python>','exec'),namespace)\ncases=swap_cases();expected=[best for _,_,_,best in cases];assert cpp_answers(wide_cpp_source(),cases)==expected\nfor n,k,state,best in cases:assert tuple(map(int,namespace['wide_swap'](f'{n} {k}\\n'+' '.join(map(str,state))).split()))==best\nchecks=[]\nfor number in (30172,27699,19962):\n directory=ROOT/f'data/openjudge/tests/admin_review_repaired/{number}';group=json.loads((directory/'SOURCE.json').read_text());evidence=json.loads((ROOT/group['evidence']).read_text())['entries'][0]\n for row in evidence['checks']['answers']['files']:\n  given=(directory/'data'/row['input']).read_bytes();answer=(directory/'data'/row['output']).read_bytes()\n  if number==19962:\n   values=list(map(int,given.split()));n=values[0];a=values[1:];assert 1<=n<=100000 and len(a)==n and all(1<=x<=100000 for x in a)\n   counts=collections.Counter(a);total=sum(a);prefix_count=prefix_sum=0;best=None\n   for x in sorted(counts):\n    cost=x*prefix_count-prefix_sum+total-prefix_sum-x*(n-prefix_count)\n    best=cost if best is None else min(best,cost)\n    prefix_count+=counts[x];prefix_sum+=counts[x]*x\n   assert int(answer)==best\n  elif number==27699:\n   if not any(c['filename']==row['input'] for c in group['changes']):continue\n   v=list(map(int,given.split()));n,k=v[:2];a=v[2:];assert k==n-1\n   # 距离至少n-1只允许交换首尾；仅当值相邻且降低首元素时交换。\n   if a[0]==a[-1]+1:a[0],a[-1]=a[-1],a[0]\n   assert list(map(int,answer.split()))==a\n  else:\n   lines=given.decode().splitlines();n=int(lines[0]);start,end=lines[1].split();assert n<=1000 and len(lines)==n+1\n   graph={end:[]}\n   for line in lines[2:]:\n    words=line.split();m=int(words[1]);assert 0<=m<=10 and len(words)==2+2*m\n    graph[words[0]]=[(words[2+2*i],int(words[3+2*i])) for i in range(m)]\n   assert len(graph)==n and all(v!=start for edges in graph.values() for v,_ in edges)\n   indegree={u:0 for u in graph}\n   for edges in graph.values():\n    for v,w in edges:indegree[v]+=1\n   queue=[u for u in graph if indegree[u]==0];heapq.heapify(queue);best={start:(0,(start,))};visited=0\n   while queue:\n    u=heapq.heappop(queue);visited+=1\n    for v,w in graph[u]:\n     if u in best:\n      score,path=best[u];proposal=(score+w,path+(v,))\n      if v not in best or proposal[0]>best[v][0] or (proposal[0]==best[v][0] and proposal[1]<best[v][1]):best[v]=proposal\n     indegree[v]-=1\n     if indegree[v]==0:heapq.heappush(queue,v)\n   expected='WRONG INPUT' if visited<n or end not in best else str(best[end][0])+'\\n'+' '.join(best[end][1])\n   assert answer.split()==expected.encode().split()\n  checks.append({'global_number':number,'input':row['input'],'input_sha256':sha(given),'answer_sha256':sha(answer),'matches':True,'reference_sha256':group['reference_sha256']})\ns=Path(__file__).read_text();result={'batch':20,'all_matched':True,'small_swap_cases':len(cases),'small_story_dags':64,'small_parcel_cases':340,'small_python_reference_sha256':proof['original_python_sha256'],'cpp_reference_sha256':proof['sha256'],'actual_independent_pairs':len(checks),'checks':checks,'tests_sha256':sha((ROOT/'tests/test_gmyhf_graph_and_swap.py').read_bytes()),'rules_sha256':sha((ROOT/'scripts/gmyhf_review_fixes.py').read_bytes()),'procedure_source':s,'procedure_sha256':sha(s.encode())}\n(ROOT/'collab/gmyhf-review-fixes-batch20-proof.json').write_text(json.dumps(result,ensure_ascii=False,indent=2)+'\\n');print(len(cases),'小排列三方一致，',len(checks),'实际对独立一致')\n",
  "procedure_sha256": "5631f569c25fe88fb755bdf3128254522325a29ab149416e79fe6fc0103b9ca7"
}
