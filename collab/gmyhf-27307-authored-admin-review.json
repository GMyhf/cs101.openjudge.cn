        "source": "from decimal import Decimal, localcontext, ROUND_HALF_EVEN\nfrom functools import lru_cache, cmp_to_key\nfrom collections import Counter, defaultdict\nimport heapq\nimport sys\nsys.setrecursionlimit(10000)\ndef assist(s):\n v=list(map(int,s.split()));n=v[0];hp=v[1:n+1];tm=v[n+1:];items=sorted(zip(hp,tm),key=lambda p:p[0]);suffix=[0]*(n+1)\n for i in range(n-1,-1,-1):suffix[i]=suffix[i+1]+items[i][1]+1\n @lru_cache(None)\n def cover(i,needed):\n  if needed<=0:return 0\n  if i==n or suffix[i]<needed:return 10**30\n  cost,time=items[i];return min(cover(i+1,needed),cost+cover(i+1,needed-time-1))\n return str(cover(0,n))\n\nsys.stdout.write(assist(sys.stdin.read()) + \"\\n\")\n",
