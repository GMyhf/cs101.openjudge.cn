  "tests_sha256": "4ac3564bbbe944be254f73c18ef3004db374c05bcaee264fd26b884169568488",
  "rules_sha256": "41e6be84f35e011fcf531699f42e2b820563184b258033dc915c96fb7aec0a42",
  "procedure_source": "\"\"\"修正数据的独立复核：自底向上基团键、浮点信息熵、贪心砖数和FIFO等待。\"\"\"\nimport hashlib,json,math,sys\nfrom fractions import Fraction\nfrom pathlib import Path\nsys.path.insert(0,str(Path.cwd()))\nfrom tests.test_gmyhf_early_semantics import reference\nsha=lambda b:hashlib.sha256(b).hexdigest();root=Path.cwd();rows=[]\nfor n in (18076,18209,21727,21728):\n target=root/f'data/openjudge/tests/admin_review_repaired/{n}'\n for path in sorted((target/'data').glob('*.in')):\n  text=path.read_text();tokens=text.split();out=path.with_suffix('.out').read_text().strip()\n  if n==18076:\n   v=list(map(int,tokens));a,b=v[:2];at=2;keys=[];groups=[]\n   for size in (a,b):\n    group=[v[at+4*i:at+4*i+4] for i in range(size)];at+=4*size;children=[[] for _ in group];canonical=[None]*size\n    for i,p,z,bond in group:\n     if p>=0:children[p].append((i,bond))\n    for i in reversed(range(size)):\n     canonical[i]=(group[i][2],tuple(sorted((group[j][2] for j,bond in children[i] for _ in range(bond)),reverse=True)),max((canonical[j] for j,bond in children[i]),default=()))\n    keys.append(canonical[0]);groups.append(group)\n   assert keys[0]!=keys[1],'截断后基团相等，题面未定义等号输出'\n   expected='1' if keys[0]>keys[1] else '2'\n   reverse=f'{b} {a}\\n'+'\\n'.join(' '.join(map(str,row)) for row in groups[1]+groups[0])\n   assert reference(n)(reverse)!=out\n  elif n==18209:\n   probabilities=[float(x) for x in tokens[1:]];assert sum(map(Fraction,tokens[1:]))==1\n   terms=[-p*math.log2(p) if p else 0 for p in probabilities];lo=min(range(len(terms)),key=lambda i:probabilities[i]);hi=max((i for i in range(len(terms)) if i!=lo),key=lambda i:probabilities[i])\n   expected=f'{math.fsum(terms):.3f}\\n{math.fsum(t for i,t in enumerate(terms) if i not in (lo,hi)):.3f}'\n  elif n==21727:\n   count,cap,*volumes=map(int,tokens);used=0;best=0\n   for x in sorted(volumes):\n    if used+x>cap:break\n    used+=x;best+=1\n   expected=str(best)\n  else:\n   values=list(map(int,tokens));count=values[0];times=values[1:1+count];order=values[1+count:];assert sorted(order)==list(range(1,count+1));elapsed=waiting=0\n   for student in order:waiting+=elapsed;elapsed+=times[student-1]\n   expected=f'{waiting/count:.2f}'\n  assert expected==out,(n,path.name)\n  rows.append({'global_number':n,'input':path.name,'input_sha256':sha(path.read_bytes()),'answer_sha256':sha(path.with_suffix('.out').read_bytes()),'independent_matches':True})\ns=Path(__file__).read_text();report={'batch':18,'all_matched':True,'actual_independent_pairs':len(rows),'checks':rows,'small_domain_checks':{'20103':243,'21727':980,'21728':1944,'20004':81},'tests_sha256':sha((root/'tests/test_gmyhf_early_semantics.py').read_bytes()),'rules_sha256':sha((root/'scripts/gmyhf_review_fixes.py').read_bytes()),'procedure_source':s,'procedure_sha256':sha(s.encode())};(root/'collab/gmyhf-review-fixes-batch18-proof.json').write_text(json.dumps(report,ensure_ascii=False,indent=2)+'\\n');print(len(rows),'实际数据独立复核；截断基团全部非等价，四类小域对拍通过')\n",
  "procedure_sha256": "cdf77a55990161667930fb62e3834d17f7c56f6bd92d8b2161033e3e70956e19"
