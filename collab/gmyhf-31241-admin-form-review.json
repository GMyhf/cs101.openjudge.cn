  "procedure_source": "\"\"\"只读绑定公开题面审核与管理员表单：要求注入题面和源码数据逐字一致。\"\"\"\nimport copy,hashlib,html,json,sys\nfrom html.parser import HTMLParser\nfrom pathlib import Path\nsys.path.insert(0,str(Path.cwd()/'scripts'));import repair_gmyhf_pending_answers as c\nclass Payloads(HTMLParser):\n def __init__(self):super().__init__();self.active=None;self.parts=[];self.result=[]\n def handle_starttag(self,tag,attrs):\n  a=dict(attrs)\n  if tag=='script' and a.get('type') in ('application/x-oj-inject-data','application/x-oj-inject-source'):\n   assert self.active is None;self.active=tuple(sorted(attrs));self.parts=[]\n def handle_data(self,d):\n  if self.active is not None:self.parts.append(d)\n def handle_endtag(self,tag):\n  if tag=='script' and self.active is not None:\n   self.result.append((self.active,''.join(self.parts)));self.active=None\np=Path('collab/gmyhf-pending-batch10-review.json');old=next(e for e in json.loads(p.read_text())['entries'] if e['global_number']==31241)\npublic=Path(old['page']).read_bytes();assert c.sha(public)==old['page_sha256']\na=Payloads();a.feed(public.decode());assert len(a.result)==5\nsession=c.platform.oj_submit.Session().login();page=session._get(c.platform.oj_submit.HOST+'/admin/problems/edit/?id=31241')\nfields=c.platform.parse_form(page);keys=('description','input','output','hint','sampleInput','sampleOutput')\nb=Payloads()\nfor k in keys:b.feed(html.unescape(fields[k]))\nassert sorted(a.result)==sorted(b.result),'公开审核题面与管理员注入内容不同'\nentry=copy.deepcopy(old);entry['checks']['statement']['field_sha256']={k:c.sha(html.unescape(fields[k]).encode()) for k in keys}\ns=Path(__file__).read_text();report={'original_evidence':str(p),'original_evidence_sha256':c.sha(p.read_bytes()),'public_page_sha256':c.sha(public),'scope':'原第10批审核公开题面，未记录后台六字段哈希；本次只读确认HTML题面和Markdown源码的压缩注入载荷逐字相同，补齐写前绑定。','identical_payloads':[{'attributes':dict(attrs),'sha256':c.sha(payload.encode())} for attrs,payload in a.result],'platform_writes':0,'procedure_source':s,'procedure_sha256':c.sha(s.encode()),'entries':[entry]}\nc.save(Path('collab/gmyhf-31241-admin-form-review.json'),report)\nprint('31241公开审核题面与管理员注入载荷一致，六字段哈希已绑定；零写入')\n",
