      "reference_sha256": "2e899d0800bcfad364dd125c784f0efdcf287d94891ff82f9af6d8ee570ce3e0",
      "reference_source": "import itertools, random, heapq\nfrom collections import Counter, deque\n\ndef single_pair(a):\n    n = len(a)\n    INF = 10 ** 30\n    apple = []\n    peach = []\n    active = []\n    both = []\n    for (i, (x, y, z)) in enumerate(a):\n        apple.append((y + z + 1 if x else INF, i))\n        peach.append((x + z + 1 if y else INF, i))\n        active.append((z + 1 if x + y else INF, i))\n        both.append((max(x, y) + z + 1 if x and y else INF, i))\n    apple.sort()\n    peach.sort()\n    active.sort()\n    best = INF\n    for (cost, i) in apple:\n        other = next((v for (v, j) in peach[:2] if j != i), INF)\n        best = min(best, cost + other)\n    for (cost, i) in both:\n        best = min(best, cost + next((v for (v, j) in active[:2] if j != i), INF))\n    return best if best < INF else -1\n\ndef three_flavors(s):\n    v = list(map(int, s.split()))\n    n = v[0]\n    assert len(v) == 1 + 3 * n\n    return str(single_pair([v[i:i + 3] for i in range(1, len(v), 3)]))\nimport sys\nsys.stdout.write(three_flavors(sys.stdin.read()) + '\\n')\n",
      "reference_language": "python3",
      "reference_file": "reference.py",
