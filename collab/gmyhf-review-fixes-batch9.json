      "reference_source": "import math, heapq, bisect, itertools, random\nfrom collections import deque, Counter\nfrom functools import lru_cache\nfrom decimal import Decimal\n\ndef digit_count(text):\n    (left, right, digit) = map(int, text.split())\n\n    def prefix(n):\n        total = 0\n        factor = 1\n        while factor <= n:\n            high = n // (10 * factor)\n            cur = n // factor % 10\n            low = n % factor\n            if digit:\n                total += high * factor\n                if cur > digit:\n                    total += factor\n                elif cur == digit:\n                    total += low + 1\n            elif high:\n                total += (high - 1) * factor\n                if cur > 0:\n                    total += factor\n                else:\n                    total += low + 1\n            factor *= 10\n        return total\n    return str(prefix(right) - prefix(left - 1))\nimport sys\nsys.stdout.write(digit_count(sys.stdin.read()) + '\\n')\n",
