      "reference_source": "import math, itertools, random, heapq, bisect, ast\nfrom collections import Counter, deque\nfrom functools import lru_cache\n\ndef arrows(text):\n    v = list(map(int, text.split()))\n    (m, n) = v[:2]\n    a = v[2:]\n    dist = [10 ** 9] * len(a)\n    dist[0] = 0\n    q = deque([0])\n    while q:\n        u = q.popleft()\n        (i, j) = divmod(u, n)\n        for (direction, (di, dj)) in enumerate(((0, 1), (0, -1), (1, 0), (-1, 0)), 1):\n            (r, c) = (i + di, j + dj)\n            if not (0 <= r < m and 0 <= c < n):\n                continue\n            w = r * n + c\n            cost = int(a[u] != direction)\n            if dist[w] > dist[u] + cost:\n                dist[w] = dist[u] + cost\n                if cost:\n                    q.append(w)\n                else:\n                    q.appendleft(w)\n    return str(dist[-1])\nimport sys\nsys.stdout.write(arrows(sys.stdin.read()) + '\\n')\n",
