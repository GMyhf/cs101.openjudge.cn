        "source": "import sys, math, itertools, random, heapq, bisect\nfrom collections import Counter, deque, defaultdict\nfrom functools import lru_cache\n\ndef valeriy(text):\n    v = list(map(int, text.split()))\n    (n, q) = v[:2]\n    a = deque(v[2:2 + n])\n    queries = v[2 + n:]\n    maximum = max(a)\n    prefix = []\n    while a[0] != maximum:\n        (x, y) = (a.popleft(), a.popleft())\n        prefix.append((x, y))\n        if x > y:\n            a.appendleft(x)\n            a.append(y)\n        else:\n            a.appendleft(y)\n            a.append(x)\n    a.popleft()\n    cycle = list(a)\n    out = []\n    for query in queries:\n        (x, y) = prefix[query - 1] if query <= len(prefix) else (maximum, cycle[(query - len(prefix) - 1) % (n - 1)])\n        out.append(f'{x} {y}')\n    return '\\n'.join(out)\nimport sys\nsys.stdout.write(valeriy(sys.stdin.read()) + '\\n')\n",
