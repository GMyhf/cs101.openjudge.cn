  "procedure_source": "\"\"\"31381本地启用回执：从真实catalog逐组复判，记录自产数据与绑定哈希。\"\"\"\nimport hashlib\nimport json\nfrom pathlib import Path\nimport shutil\nimport sys\nfrom datetime import datetime,timezone\n\nROOT=Path.cwd();sys.path.insert(0,str(ROOT));import judge\nsha=lambda raw:hashlib.sha256(raw).hexdigest()\nitem=judge.catalog_item('practice','31381');assert item['test_count']==21 and item['checker'].endswith('/31381_made/checker.py')\nbase=ROOT/'data/openjudge/tests/30000-/31381_made';prefix='s = input()\\n'\nprograms={'identity':prefix+'print(s)\\n','reverse':(base/'samplecode.py').read_text(),'sorted':prefix+\"print(''.join(sorted(s)))\\n\",'append_invalid':prefix+\"print(s + '~')\\n\",'replace_invalid':prefix+\"print(chr(ord(s[0]) ^ 1)+s[1:] if s else '~')\\n\",'drop_invalid':prefix+\"print(s[1:] if s else '~')\\n\",'strip_invalid':prefix+'print(s.strip())\\n','set_invalid':prefix+\"print(''.join(sorted(set(s))))\\n\",'extra_line_invalid':prefix+\"print(s + '\\\\n')\\n\"}\nresults=[]\nfor name,source in programs.items():\n    wanted='Wrong Answer' if name.endswith('_invalid') else 'Accepted'\n    result=judge.judge('practice','31381','python',source,collect_case_times=True)\n    assert result['status']==wanted,(name,result)\n    results.append({'name':name,'language':'python','source':source,'source_sha256':sha(source.encode()),'expected':wanted,'result':result});print(name,result['status'],flush=True)\nif shutil.which('g++'):\n    source='#include <iostream>\\n#include <string>\\nint main(){std::string s;std::getline(std::cin,s);std::cout<<s<<\"\\\\n\";}\\n'\n    result=judge.judge('practice','31381','cpp',source,collect_case_times=True);assert result['status']=='Accepted',result\n    results.append({'name':'cpp_identity','language':'cpp','source':source,'source_sha256':sha(source.encode()),'expected':'Accepted','result':result});print('cpp_identity',result['status'],flush=True)\nfiles={str(p.relative_to(ROOT)):sha(p.read_bytes()) for p in sorted((base/'data').iterdir())}\nsource=Path(__file__).read_text();paths=[base/'checker.py',base/'producecase.py',base/'samplecode.py',ROOT/'data/openjudge/pages/practice__31381.html',ROOT/'data/openjudge/catalog.json',ROOT/'data/openjudge/test_index.json',ROOT/'data/openjudge/limits.json',ROOT/'scripts/index_tests.py',ROOT/'tests/test_31381_activation.py',ROOT/'tests/test_input_constraints.py',ROOT/'collab/gmyhf-31381-activation-mutations.json']\nreport={'scope':'用户授权在本地practice/31381绑定并启用，21组自产数据、既有逐题SPJ；未更改OpenJudge远端配置或测试。','checked_at':datetime.now(timezone.utc).isoformat(),'local_path':'/practice/31381/','source_url':item['source_url'],'global_number':31381,'test_count':21,'checker':item['checker'],'data_files_sha256':files,'binding_and_sources_sha256':{str(p.relative_to(ROOT)):sha(p.read_bytes()) for p in paths},'catalog_entry_sha256':sha(json.dumps(item,ensure_ascii=False,sort_keys=True).encode()),'results':results,'platform_writes':0,'mutation_count':10,'procedure_source':source,'procedure_sha256':sha(source.encode())}\n(ROOT/'collab/gmyhf-31381-activation.json').write_text(json.dumps(report,ensure_ascii=False,indent=2)+'\\n')\nprint('真实catalog绑定、21组数据、自产正误程序验收完成',flush=True)\n",
