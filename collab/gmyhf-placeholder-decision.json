  "procedure_source": "import json,hashlib,sys,re,html\nfrom pathlib import Path\nR=Path.cwd();sys.path.insert(0,str(R));import judge\nfrom scripts.index_tests import read_global_number\nold=json.loads((R/'collab/gmyhf-normal-local-activation.json').read_text());kept=(27207,29337,29893);retired=(29894,31178,31200)\nsha=lambda b:hashlib.sha256(b).hexdigest()\nfor path,digest in old['unchanged_data_and_generators_sha256'].items():assert sha((R/path).read_bytes())==digest,path\nresults=[];remote=[]\nfor n in kept:\n page=Path(f'/tmp/gmyhf-practice-confirmed-{n}.html');raw=page.read_bytes();assert read_global_number(page)==n\n remote.append({'number':n,'url':f'http://cs101.openjudge.cn/practice/{n}/','global_number':n,'title':html.unescape(re.search(r'<title>(.*?)</title>',raw.decode(),re.S).group(1)),'raw_page_sha256':sha(raw),'platform_writes':0})\n previous=next(e for e in old['entries'] if e['number']==n)\n for check in previous['results']:\n  result=judge.judge('practice',str(n),check['language'],check['source'],collect_case_times=True);assert result['status']==check['expected'],(n,result)\n  results.append({'number':n,'language':check['language'],'expected':check['expected'],'source_sha256':sha(check['source'].encode()),'result':result});print(n,check['language'],result['status'],flush=True)\npaths=['scripts/index_tests.py','scripts/crawl_openjudge.py','scripts/materialize_gmyhf_downloads.py','tests/test_gmyhf_normal_activation.py','tests/test_gmyhf_placeholder_exclusions.py','data/openjudge/catalog.json','data/openjudge/test_index.json','data/openjudge/books/practice__11.html','data/openjudge/limits.json','collab/input-domains.json','collab/valid-contracts.json','collab/gmyhf-placeholder-decision-mutations.json']\nreport={'date':'2026-10-25','decision':'用户指定27207、29337、29893正式链接；29894重复29893，31178和31200记为占位题。','active_problems':list(kept),'placeholder_exclusions':{'29894':'重复29893；正式题保留29893','31178':'用户裁定占位题','31200':'用户裁定占位题'},'public_pages_verified':remote,'platform_writes':0,'historical_data_and_generators_unchanged':True,'historical_hash_reference':'collab/gmyhf-normal-local-activation.json','supersedes':'第30批非废弃分类、第31批补数据及第32批六题启用均为历史；当前仅三题正式启用，其余三题占位排除，历史数据不删除。','retired_contract_baseline_dirs':[f'tests/{\"20000-29982\" if n<30000 else \"30000-\"}/{n}_made' for n in retired],'contract_note':'按明确占位退役裁定移出活目录账本；实际valid函数及数据字节保留，没有修改判据或放宽契约。','catalog_count':2050,'catalog_with_tests':2049,'accepted_python_cases':63,'accepted_cpp_cases':63,'wrong_answer_probes':6,'results':results,'sources_sha256':{p:sha((R/p).read_bytes()) for p in paths},'procedure_source':Path(__file__).read_text()}\n(R/'collab/gmyhf-placeholder-decision.json').write_text(json.dumps(report,ensure_ascii=False,indent=2)+'\\n')\n"
}
