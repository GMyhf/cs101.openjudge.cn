        "source": "from decimal import Decimal, localcontext, ROUND_HALF_EVEN\nfrom functools import lru_cache, cmp_to_key\nfrom collections import Counter, defaultdict\nimport heapq\nimport sys\nsys.setrecursionlimit(10000)\ndef parcel(s):\n a=list(map(int,s.split()))[1:];median=heapq.nsmallest(len(a)//2+1,a)[-1];return str(sum(abs(x-median) for x in a))\n\nsys.stdout.write(parcel(sys.stdin.read()) + \"\\n\")\n",
