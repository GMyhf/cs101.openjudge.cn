          "definition": "def valid(text):\n    \"\"\"题面契约：首行 N，1<=N<=100000；第二行恰 N 个整数 Ai，1<=Ai<=100000。\"\"\"\n    try:\n        if not text.endswith(\"\\n\"):\n            return False\n        lines = text[:-1].split(\"\\n\")\n        if len(lines) != 2:\n            return False\n        n = int(lines[0])\n        if not 1 <= n <= 100000:\n            return False\n        a = lines[1].split(\" \")\n        if len(a) != n:\n            return False\n        return all(1 <= int(x) <= 100000 for x in a)\n    except ValueError:\n        return False"
        },
