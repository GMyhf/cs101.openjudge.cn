[Unit]
Description=CS101 OpenJudge 本机判题服务
Documentation=https://github.com/GMyhf/cs101.openjudge.cn
After=network-online.target
Wants=network-online.target

# 进入失败状态时告警。Restart=on-failure 会把服务拉起来，
# 但崩溃循环因此是**静默**的 —— 自动恢复不该等于无人知晓。
OnFailure=cs101-alert@%n.service

[Service]
Type=simple
# 换机器时只需要改这三行（User/Group 与 WorkingDirectory）。
User=rocky
Group=rocky
WorkingDirectory=/home/rocky/git/cs101.openjudge.cn

Environment=CS101_HOST=0.0.0.0
Environment=CS101_PORT=8000
# systemd 不继承登录 shell 的 PATH，默认只有 /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin。
# 而 pypy3 装在 ~/.local/bin —— 改用 systemd 托管之后，判题器 `shutil.which("pypy3")`
# 就找不到它了，学生选 PyPy3 会得到 Language Unavailable。PyPy3 正是 Python 超时时
# 唯一的补救档（倍率 ×3 对 ×10），这条不能少。
#
# 放宽这里**不会扩大判题沙箱**：判题器用服务进程的 PATH 找到解释器后，
# 交给子进程的是**绝对路径**，子进程自己的 env 仍然是固定的
# {PATH=/usr/local/bin:/usr/bin:/bin, HOME=临时目录}（judge.py 的 CHILD_PATH）。
Environment=PATH=/home/rocky/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# 管理员口令与 SMTP 由 server.py 自己从 data/.admin_password、data/.smtp.env 读，
# 不要写进这里 —— unit 文件是全局可读的。
ExecStart=/usr/bin/python3 -u server.py

# 默认软上限 1024 对判题服务太低：每个并发判题要占一个客户端连接、三个子进程管道，
# 再加临时文件。100 并发实测已用到 644 个。用满之后 accept 失败，
# 客户端看到的是「连上了又被断开」，而服务端日志里什么都没有 —— 那些连接根本没被 accept。
LimitNOFILE=65536

Restart=on-failure
RestartSec=3

# 判题会把用户代码拉起成子进程。停止时必须带走整棵进程树，
# 否则正在跑的用户程序会留成孤儿继续占 CPU。
KillMode=control-group
# 一次判题最长 300 秒（judge.py 的 TOTAL_HARD_CAP_S），但重启不必等它跑完：
# 给 20 秒收尾，然后连同子进程一起 SIGKILL。
TimeoutStopSec=20

# 日志走 journal（`journalctl -u cs101`），不要写 `StandardOutput=append:.../server.log`：
# SELinux 是 Enforcing，systemd 以 init_t 打开 home 目录下的文件会被拒，
# 服务会以 209/STDOUT 反复重启起不来。2026-07-28 实测踩过。

# 判题沙箱本身由 judge.py 的 _limits() 负责（RLIMIT_CPU/FSIZE/AS + env 白名单），
# 这里只加两条不会干扰它的：私有 /tmp（判题的临时目录就在 /tmp 下），
# 以及禁止提权（用户代码不该能靠 setuid 拿到更多权限）。
# 不要加 ProtectHome —— 工作目录就在 /home 下，加了服务直接起不来。
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
